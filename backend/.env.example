MODEL_API_KEY=
DATABASE_URL=postgresql+psycopg://orderguard:YOUR_PASSWORD@127.0.0.1:5432/orderguard
ORDERGUARD_BUSINESS_ID=little-crumb-v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Tests require a dedicated PostgreSQL database; never use a production database.
# TEST_DATABASE_URL=postgresql+psycopg://orderguard:YOUR_PASSWORD@127.0.0.1:5432/orderguard_test

# Optional M4 adapter. Keep disabled until account ownership and permissions are verified.
INSTAGRAM_INGEST_ENABLED=false
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Set only to the version verified for your own Meta app; no version is guessed.
INSTAGRAM_API_VERSION=
# Server-side secret reference; token content is never stored in PostgreSQL or returned to the UI.
INSTAGRAM_ACCESS_TOKEN_DEFAULT=
# Compose hard-disables outbound delivery; no public send route is implemented.
INSTAGRAM_OUTBOUND_ENABLED=false

# Optional, documented Meta reasoning controls. Empty preserves the working default.
MUSE_REPLY_REASONING_EFFORT=
MUSE_INTERPRET_REASONING_EFFORT=
MUSE_SETUP_REASONING_EFFORT=
