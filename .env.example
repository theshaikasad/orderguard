# Copy to .env and set a private database password before starting Compose.
POSTGRES_PASSWORD=
# Existing Meta Model API credential. Only passed to the backend at runtime.
MODEL_API_KEY=
ORDERGUARD_BUSINESS_ID=little-crumb-v1
# Loopback by default. A server needs deliberate network/TLS/access configuration.
BIND_HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Optional external PostgreSQL URL (server-side only); defaults to the Compose DB.
# DATABASE_URL=postgresql+psycopg://user:password@database-host/orderguard?sslmode=require
# API_INTERNAL_URL=http://backend:8000
